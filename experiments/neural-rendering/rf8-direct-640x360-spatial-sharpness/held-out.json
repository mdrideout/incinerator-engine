{
  "schema": 1,
  "experiment": "RF8",
  "stage": "held_out_structural_reconstruction",
  "train_splits": ["overfit", "train"],
  "selection_split": "validation",
  "test_policy": "open exactly once only after immutable validation selection",
  "device": "mps",
  "initialization_seed": 2026081203,
  "training_seed": 2026081204,
  "epochs": 240,
  "batch_size": 1,
  "validate_every_epochs": 5,
  "model": {
    "name": "rf8_direct_640x360_spatial_v2",
    "features": 64,
    "low_blocks": 8,
    "output_blocks": 6,
    "semantic_embedding": 8,
    "instance_embedding": 16,
    "refinement_features": 48,
    "output_width": 640,
    "output_height": 360
  },
  "loss": {
    "reconstruction": 1.0,
    "log_luminance": 0.2,
    "chroma": 0.15,
    "multiscale_color": 0.1,
    "gradient": 0.15,
    "high_frequency": 0.15,
    "laplacian": 0.12,
    "local_contrast": 0.08,
    "semantic_edge": 0.08,
    "instance_edge": 0.08,
    "geometry": 0.08,
    "negative_radiance": 0.02
  },
  "optimizer": {"name": "AdamW", "learning_rate": 0.0005, "weight_decay": 0.00001},
  "scheduler": {"name": "CosineAnnealingLR", "minimum_learning_rate": 0.00001},
  "selection_metric": "validation spatial_quality_score",
  "ablations": ["appearance_only", "no_semantic", "no_instance", "no_globals"],
  "pretrained_weights": false,
  "promotion_eligible": false
}
